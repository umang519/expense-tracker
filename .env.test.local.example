# Copy this file to .env.test.local and fill in real values to run `npm run test:e2e`.
#
# Use a DEDICATED test database — same Atlas cluster is fine, just a different
# DB name in the connection string (e.g. .../expense-tracker-test?...) so E2E
# runs never touch real user data. global-setup.ts wipes and reseeds a single
# fixed test user (tests/e2e/testUser.ts) in this DB on every run.

MONGODB_URI=
JWT_SECRET=
